{
  "name": "hogam",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // 도메인 네임서버를 Cloudflare로 옮긴 뒤 아래 주석을 풀고 다시 배포
  "routes": [
    { "pattern": "ho-gam.com", "custom_domain": true },
    { "pattern": "www.ho-gam.com", "custom_domain": true }
  ],
  // 호텔감성.com 네임서버를 Cloudflare로 옮긴 뒤 추가
  // "routes": [
  //   { "pattern": "xn--439as41bbylcte.com", "custom_domain": true },
  //   { "pattern": "www.xn--439as41bbylcte.com", "custom_domain": true }
  // ],
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
